// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id           String   @id @default(uuid())
  name         String
  description  String
  icon         String
  color        String
  isFavorite   Boolean  @default(false)
  createdAt    BigInt
  lastOpenedAt BigInt
  
  // Stats
  documentCount Int @default(0)
  templateCount Int @default(0)
  chatCount     Int @default(0)

  templates    Template[]
}

model Template {
  id           String   @id @default(uuid())
  name         String
  category     String
  uploadDate   BigInt
  sizeBytes    BigInt
  usageCount   Int      @default(0)
  isFavorite   Boolean  @default(false)
  filePath     String
  fileType     String?
  version      Int?     @default(1)
  
  workspaceId  String?
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Job {
  id           String   @id
  userId       String
  templateId   String
  status       String   // 'queue' | 'processing' | 'completed' | 'failed'
  progress     Int      @default(0)
  totalFiles   Int
  successCount Int      @default(0)
  failedCount  Int      @default(0)
  startTime    BigInt
  finishTime   BigInt?
  downloadUrl  String?
  zipSize      BigInt?
  expireAt     BigInt?
}

model CacheEntry {
  id                 String   @id
  excelHash          String
  templateName       String
  templateVersion    String
  promptVersion      String
  aiVersion          String
  mappingResult      Json
  placeholderMapping Json
  metadata           Json
  outputDocxPath     String?
  outputPdfPath      String?
  createdAt          BigInt
  sizeBytes          BigInt
  hits               Int      @default(0)
}

model UserLearningProfile {
  userId               String   @id
  favoriteTemplates    Json     // { [templateId: string]: number }
  favoriteDateFormat   String?
  favoriteLanguage     String?
  favoriteWritingStyle String?
  favoriteImageOptions Json?
  confidenceScores     Json     // { [key: string]: number }
}
